#this is an example of .env file. copy it to .env file and fill it(or just use it as an example of filling your user secrets)

#do NOT expose it on github(by default it is excluded in gitignore)

#ConnectionString to connect to the database(WITHOUT  docker compose). Make sure to change the password and other parameters as needed.
ConnectionStrings__AdminApiDb=Host=localhost;Port=5432;Database=Vladify.AdminApi;Username=your_username;Password=yourpassword

#used by docker compose: creates the postgres container and builds the in-container connection string
#(the app itself reads ConnectionStrings__AdminApiDb above, not these)
DbPassword=Your_password123
DbName=your_db_name
DbUser=your_db_user

#Auth0 configuration. You can get these values from your Auth0 dashboard.

Auth0Options__Domain=your_auth0_domain(without https://)
Auth0Options__ClientId=your_auth0_client_id
Auth0Options__Audience=your_audience(example:https://Vladify/musicAPI)

#ASPNETCORE_ENVIRONMENT(use for Scalar documentation & testing)
ASPNETCORE_ENVIRONMENT=Development(or other)
